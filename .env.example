# Cloudflare Pages build variables (public Supabase settings only)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
# Empty locally; set to the Render API origin in Cloudflare Pages production
VITE_VISION_API_URL=
# Optional compatibility alias; use the Render service origin, without /api paths
VITE_API_URL=

# Node squad API only (never prefix secrets with VITE_)
GEMINI_API_KEY=your_gemini_api_key
GEMINI_PRIMARY_MODEL=gemini-4-argon
GEMINI_FALLBACK_MODEL=gemini-3.8-flash
GEMINI_TERTIARY_MODEL=gemini-3.6-flash
FRONTEND_ORIGIN=https://your-project.pages.dev
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
PORT=3001

# Optional orchestration limits
GEMINI_BATCH_SIZE=15
GEMINI_SMALL_BATCH_SIZE=8
GEMINI_RETRY_LIMIT=3
GEMINI_MAX_CALLS=30
GEMINI_PROCESSING_TIMEOUT_MS=300000
